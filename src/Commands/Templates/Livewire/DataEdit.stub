<?php

namespace {{classNamespace}};

use App\Modules\Auth\Traits\Authorize;
use App\Modules\Auth\Traits\Limit;
use {{baseClass}};
use {{modelNamespace}}\{{model}};


class {{class}} extends {{baseClassName}}
{
    use Authorize, Limit;

    public ${{ item }};

    protected $rules = [
        {{ rules }}
    ];

    public function booted(): void
    {
        $this->authorize('admin|edit {{table}}', $this->{{ item }});
        $this->limit();
    }

    public function mount({{model}} ${{ item }})
    {
       $this->{{ item }} = ${{ item }};
    }

    public function save()
    {
        $this->validate();
        $this->{{ item }}->save();
        #redirect
    }

    public function render()
    {
        return view('{{view}}')->layout('{{layout}}');
    }
}
