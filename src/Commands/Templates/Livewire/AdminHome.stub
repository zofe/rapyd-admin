<?php

namespace {{classNamespace}};

use Illuminate\Support\Facades\Route;
use Livewire\Component;
use Zofe\Rapyd\Modules\Log\Models\Activity;

/**
 * The admin dashboard: what the core already counts, what happened lately, what is left to set up.
 * Generated by rpd:make:home into your application — it is yours to change.
 */
class {{class}} extends Component
{
    public function render()
    {
        return view('{{view}}', [
            'tiles' => $this->tiles(),
            'recent' => $this->recent(),
            'steps' => $this->gettingStarted(),
        ])->layout('{{layout}}');
    }

    /** One tile per thing the core manages, only those this user may open: label, count, icon, route. */
    protected function tiles(): array
    {
        $user = auth()->user();
        $tiles = [];

        if ($user->hasRoleOrPermission('admin|view everything|edit everything|view users|edit users')) {
            $users = config('auth.providers.users.model');
            $tiles[] = ['label' => 'Users', 'count' => $users::count(), 'icon' => 'user', 'route' => 'auth.users'];
        }

        if (config('rapyd.companies.enabled', true) && Route::has('companies.table')
            && $user->hasRoleOrPermission('admin|view everything|edit everything|view companies|edit companies|view own business|edit own business')) {
            $tiles[] = ['label' => 'Companies', 'count' => \Zofe\Rapyd\Modules\Companies\Models\Company::count(), 'icon' => 'building', 'route' => 'companies.table'];
        }

        if ($user->hasRoleOrPermission('admin|view everything|edit everything|view users|edit users')) {
            $roles = config('permission.models.role');
            $tiles[] = ['label' => 'Roles', 'count' => $roles::count(), 'icon' => 'key', 'route' => 'auth.permissions'];
        }

        if ($this->canSeeActivity()) {
            $tiles[] = ['label' => 'Activity, last 24h', 'count' => Activity::where('created_at', '>=', now()->subDay())->count(), 'icon' => 'clock', 'route' => 'log.activity'];
        }

        return $tiles;
    }

    /** The last things that happened, from the activity log the core keeps. */
    protected function recent()
    {
        if (! $this->canSeeActivity()) {
            return collect();
        }

        return Activity::with('causer')->latest()->limit(8)->get();
    }

    protected function canSeeActivity(): bool
    {
        return Route::has('log.activity') && auth()->user()->hasRoleOrPermission('admin|view everything|view logs');
    }

    /**
     * What a fresh application still has to do, each item checked for real. Shown to admins only,
     * and the card disappears once everything is ticked.
     *
     * @return array<int, array{label: string, done: bool, hint: string}>
     */
    protected function gettingStarted(): array
    {
        if (! auth()->user()->hasRoleOrPermission('admin')) {
            return [];
        }

        $users = config('auth.providers.users.model');
        $admin = $users::where('email', 'admin@laravel')->first();

        $steps = [
            ['label' => 'First admin created', 'done' => true, 'hint' => ''],
        ];

        if ($admin) {
            $steps[] = [
                'label' => 'Change the password of admin@laravel',
                'done' => $admin->updated_at->gt($admin->created_at->addMinute()),
                'hint' => 'the one printed by rpd:make:setup is meant to be replaced',
            ];
        }

        $steps[] = [
            'label' => 'Set your brand',
            'done' => filled(config('rapyd.layout.brand')) || filled(config('rapyd.layout.logo_sidebar')),
            'hint' => 'RAPYD_BRAND or RAPYD_LOGO_SIDEBAR in .env',
        ];
        $steps[] = [
            'label' => 'Generate your first module',
            'done' => count(glob(app_path('Modules/*'), GLOB_ONLYDIR) ?: []) > 0,
            'hint' => 'php artisan rpd:make Things Thing --module=Name --fields="name,active:boolean"',
        ];
        $steps[] = [
            'label' => 'Google sign-in',
            'done' => filled(config('services.google.client_id')),
            'hint' => 'GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in .env',
        ];
        $steps[] = [
            'label' => 'Your AI agent knows Rapyd Admin',
            'done' => is_dir(base_path('.claude/skills/rapyd-module'))
                || (is_file(base_path('AGENTS.md')) && str_contains(file_get_contents(base_path('AGENTS.md')), 'zofe/rapyd-admin')),
            'hint' => 'php artisan boost:install (with Laravel Boost) or php artisan rpd:ai',
        ];

        return $steps;
    }
}
