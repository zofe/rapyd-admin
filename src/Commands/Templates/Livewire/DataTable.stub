<?php

namespace {{classNamespace}};

use App\Modules\Auth\Traits\Authorize;
use App\Modules\Auth\Traits\Limit;
use {{baseClass}};
use {{modelNamespace}}\{{model}};
use {{traitNamespace}}\{{traitClass}};

class {{class}} extends {{baseClassName}}
{
    use {{traitClass}}, Authorize, Limit;

    public $search = '';
    public $sortField = 'id';

    public function booted(): void
    {
        $this->authorize('admin|view {{table}}|edit {{table}}');
        $this->limit();
    }

    public function getDataSet()
    {
        $items = {{model}}::{{whereSearch}};


        return $items = $items
            ->orderBy($this->sortField, $this->sortAsc ? 'asc' : 'desc')
            ->paginate($this->perPage)
            ;
    }

    public function render()
    {

        $items = $this->getDataSet();
        return view('{{view}}', compact('items'))->layout('{{layout}}');
    }
}
