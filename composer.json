{
    "name": "zofe/rapyd-admin",
    "description": "rapyd admin for laravel",
    "keywords": [
        "zofe",
        "rapyd"
    ],
    "homepage": "https://github.com/zofe/rapyd-admin",
    "license": "MIT",
    "authors": [
        {
            "name": "Felice Ostuni",
            "email": "felice.ostuni@gmail.com",
            "homepage": "https://feliceostuni.com",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/zofe/laravel-stub-generator"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/fortify": "^1.0",
        "laravel/serializable-closure": "^2.0",
        "laravel/socialite": "^5.0",
        "livewire/livewire": "^4.0",
        "propaganistas/laravel-disposable-email": "^2.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-ignition": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "Zofe\\Rapyd\\": "src",
            "Zofe\\Rapyd\\Database\\Factories\\": "database/factories",
            "App\\Modules\\": "app/Modules"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Zofe\\Rapyd\\Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit --colors=always",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Zofe\\Rapyd\\RapydServiceProvider"
            ],
            "aliases": {
                "Rapyd": "Zofe\\Rapyd\\RapydFacade"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/zofe"
        },
        {
            "type": "other",
            "url": "https://feliceostuni.com"
        }
    ]
}
